# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 构建产物 ──────────────────────────────────────────
dist/
server/bin/
*.exe
*.exe~
*.dll
*.so

# ── Go 构建缓存 ───────────────────────────────────────
# GOCACHE/GOPATH 被指向了项目内目录，入库会瞬间膨胀上百 MB。
server/gocache/
server/gopath/

# ── 运行时数据（含用户决策记录，属隐私，不入库）────────
server/telemetry.jsonl
server/decisions.json
server/smoke-*.json
server/smoke-*.jsonl

# ── 本地工作记忆 ──────────────────────────────────────
.workbuddy/

# ── 密钥与本地环境变量（绝不入库）────────────────────
# API Key 一律走环境变量传入；万一有人图省事写了 .env，这里兜底挡住。
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
# 本地启动脚本的密钥文件（start-real.sh 从这里读取 Key）
key.env
!key.env.example

# ── 编辑器与系统 ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
